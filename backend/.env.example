# Copie para .env e ajuste conforme necessário. Todas as variáveis usam o
# prefixo DOCUFLOW_ de propósito, para nunca colidir com variáveis de
# ambiente genéricas (ex.: DATABASE_URL) que outras ferramentas/projetos
# possam já ter definido na máquina.

DOCUFLOW_SECRET_KEY=troque-por-uma-chave-aleatoria-em-producao
DOCUFLOW_FRONTEND_BASE_URL=http://localhost:5173

# Limites do plano gratuito
DOCUFLOW_FREE_PLAN_MONTHLY_LIMIT=5
DOCUFLOW_FREE_PLAN_MAX_SIGNERS=1

# Lembretes automáticos (plano Pro)
DOCUFLOW_REMINDER_AFTER_DAYS=2
DOCUFLOW_REMINDER_MIN_INTERVAL_DAYS=2

# SMTP opcional — se não configurado, e-mails são simulados em storage/emails/
DOCUFLOW_SMTP_HOST=
DOCUFLOW_SMTP_PORT=587
DOCUFLOW_SMTP_USER=
DOCUFLOW_SMTP_PASSWORD=
DOCUFLOW_SMTP_FROM=no-reply@docuflow.local
